{
 "S07": {"cell": 2, "title": "Phase 0 · the rules, written as code",
  "code": ["PROBLEM = {",
           "    \"unit\": \"one order\",",
           "    \"prediction_time\": \"order placement (checkout)\",",
           "    \"target\": \"is_late = delivered after the",
           "               promised date\",",
           "    \"primary_metric\": \"PR-AUC (average precision)\",",
           "    \"rules\": [\"only checkout-time features\",",
           "              \"chronological split\",",
           "              \"test set used once\"],",
           "}"],
  "hl": [[2, 2, "checkout"], [8, 8, "once"]],
  "out": ["unit             one order", "prediction_time  order placement (checkout)", "primary_metric   PR-AUC (average precision)"],
  "out_hl": null, "out_t": "rules", "excerpt": true},
 "C01": {"cell": 4, "title": "Phase 1 · load every table",
  "code": ["names = [\"orders\", \"order_items\", \"order_payments\",",
           "         \"customers\", \"products\", \"sellers\",",
           "         \"order_reviews\", \"geolocation\"]",
           "t = {n: pd.read_csv(f\"{RAW}olist_{n}_dataset.csv\")",
           "     for n in names}",
           "pd.DataFrame({n: [d.shape[0], d.shape[1],",
           "                  int(d.isna().sum().sum()),",
           "                  int(d.duplicated().sum())]",
           "              for n, d in t.items()},",
           "             index=[\"rows\", \"cols\", \"missing\",",
           "                    \"duplicates\"]).T"],
  "hl": [[3, 4, "dictionary"], [5, 10, "rows"]],
  "out": ["              rows  cols  missing  duplicates", "orders       99441     8     4908           0", "order_items 112650     7        0           0", "customers    99441     5        0           0"],
  "out_hl": "99441", "out_t": "duplicates"},
 "C02": {"cell": 6, "title": "Phase 1 · find the real customer",
  "code": ["c = t[\"customers\"]",
           "per_person = (orders.merge(c, on=\"customer_id\")",
           "              .groupby(\"customer_unique_id\").size())",
           "print(f\"people: {len(per_person):,}   \"",
           "      f\"ordered more than once: \"",
           "      f\"{(per_person > 1).mean():.1%}\")"],
  "hl": [[1, 2, "merge"]],
  "out": ["people: 96,096   ordered more than once: 3.1%"],
  "out_hl": "3.1%", "out_t": "count"},
 "C03": {"cell": 12, "title": "Phase 3 · the label",
  "code": ["df[\"is_late\"] = (",
           "    df[\"order_delivered_customer_date\"].dt.normalize()",
           "    > df[\"order_estimated_delivery_date\"]",
           ").astype(int)",
           "print(f\"late rate: {df['is_late'].mean():.2%}\")"],
  "hl": [[1, 2, "later"]],
  "out": ["late rate: 6.83%", "promised: 24 days median   actual: 11 days median", "arrived early by 13 days (median)"],
  "out_hl": "6.83%", "out_t": "print"},
 "S15": {"cell": 20, "title": "Phase 5b · the leakage guard",
  "code": ["LEAKY = [\"order_approved_at\",",
           "         \"order_delivered_carrier_date\",",
           "         \"order_delivered_customer_date\",",
           "         \"actual_days\", \"order_status\",",
           "         \"review_score\"]",
           "FEATURES = NUM + CAT",
           "assert not set(FEATURES) & set(LEAKY), \\",
           "    \"leaky column in features\""],
  "hl": [[6, 7, "stops"]],
  "out": ["22 features, none known only after checkout"],
  "out_hl": "22 features", "out_t": "allowed"},
 "C04": {"cell": 18, "title": "Phase 5 · seller history, past only",
  "code": ["ev[\"seller_prev_late\"] = (",
           "    ev.groupby(\"seller_id\")[\"is_late\"].cumsum())",
           "hist = pd.merge_asof(",
           "    df[[\"order_purchase_timestamp\", \"seller_id\"]]",
           "      .reset_index(),",
           "    ev.rename(columns={",
           "        \"order_delivered_customer_date\": \"t\"})",
           "      [[\"t\", \"seller_id\", \"seller_prev_deliveries\",",
           "        \"seller_prev_late\"]],",
           "    left_on=\"order_purchase_timestamp\",",
           "    right_on=\"t\", by=\"seller_id\",",
           "    allow_exact_matches=False).set_index(\"index\")"],
  "hl": [[2, 2, "merge"], [11, 11, "exact"]],
  "out": ["       seller_prev_deliveries  seller_late_rate", "mean                  163.974             0.051"],
  "out_hl": "0.051", "out_t": "strictly", "excerpt": true},
 "C06": {"cell": 22, "title": "Phase 6 · split by time",
  "code": ["base = df[df[\"order_purchase_timestamp\"] < \"2018-07-01\"]",
           "n = len(base); a, b = int(n * .70), int(n * .85)",
           "train, val, test = (base.iloc[:a],",
           "                    base.iloc[a:b], base.iloc[b:])"],
  "hl": [[1, 3, "slices"]],
  "out": ["train 58,587  2017-01-05 to 2018-03-07  late 7.2%", "val   12,554  2018-03-07 to 2018-05-02  late 9.7%", "test  12,555  2018-05-02 to 2018-06-30  late 4.0%"],
  "out_hl": "late 9.7%", "out_t": "shuffling", "excerpt": true},
 "C07": {"cell": 26, "title": "Phase 8 · LightGBM",
  "code": ["gbm = lgb.LGBMClassifier(",
           "    n_estimators=2000, learning_rate=0.03,",
           "    num_leaves=31, min_child_samples=50,",
           "    subsample=0.8, subsample_freq=1,",
           "    colsample_bytree=0.8, random_state=SEED,",
           "    verbose=-1)",
           "gbm.fit(Xtr, ytr, eval_set=[(Xva, yva)],",
           "        eval_metric=\"average_precision\",",
           "        callbacks=[lgb.early_stopping(100,",
           "                                      verbose=False)])",
           "print(\"best iteration:\", gbm.best_iteration_)"],
  "hl": [[1, 1, "2000"], [8, 9, "early"]],
  "out": ["best iteration: 78"],
  "out_hl": "78", "out_t": "78"},
 "C08": {"cell": 38, "title": "Phase 13 · the promise model",
  "code": ["def fit_q(alpha):",
           "    q = lgb.LGBMRegressor(",
           "        objective=\"quantile\", alpha=alpha,",
           "        n_estimators=600, learning_rate=0.05,",
           "        num_leaves=31, min_child_samples=50,",
           "        random_state=SEED, verbose=-1)",
           "    return q.fit(train[NUM_P + CAT],",
           "                 train[\"actual_days\"])",
           "for alpha in [0.85, 0.88, 0.90, 0.92, 0.94, 0.96]:",
           "    ..."],
  "hl": [[2, 2, "quantile"], [8, 8, "six"]],
  "out": ["alpha 0.85  late 9.21%  mean promise 21.7 d", "alpha 0.88  late 7.62%  mean promise 23.0 d", "chosen alpha 0.85 (Olist late rate on validation 9.73%)"],
  "out_hl": "chosen alpha 0.85", "out_t": "validation", "excerpt": true},
 "C09": {"cell": 44, "title": "Experiment 2 · the 30-day signal",
  "code": ["hi = np.searchsorted(t_ev, tq, side=\"left\")",
           "lo = np.searchsorted(",
           "    t_ev, tq - np.timedelta64(days, \"D\"),",
           "    side=\"left\")",
           "cnt = hi - lo",
           "out.loc[d.index] = np.where(",
           "    cnt >= 20,",
           "    (cum[hi] - cum[lo]) / np.maximum(cnt, 1),",
           "    np.nan)"],
  "hl": [[0, 3, "binary"], [6, 6, "fewer"]],
  "out": ["       recent_late_30d  recent_late_30d_state", "mean             0.066                  0.065"],
  "out_hl": "0.066", "out_t": "empty", "excerpt": true}
