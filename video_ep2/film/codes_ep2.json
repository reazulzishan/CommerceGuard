 "E23": {"cell": 16, "title": "Model 2 · history from the past only",
  "code": ["for col in [\"n\", \"c\"]:",
           "    day[\"prev_\" + col] = (day.groupby(\"cust\")[col]",
           "                         .cumsum() - day[col])",
           "lag = day[[\"cust\", \"date\", \"cum_r\", \"cum_n\"]].assign(",
           "    date=lambda d: d[\"date\"] + pd.Timedelta(days=30))",
           "p = pd.merge_asof(p.sort_values(\"date\"),",
           "                  lag.rename(columns={\"cum_r\": \"old_r\",",
           "                                      \"cum_n\": \"old_n\"}),",
           "                  on=\"date\", by=\"cust\", direction=\"backward\")"],
